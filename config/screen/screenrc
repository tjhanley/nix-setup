startup_message off
defutf8 on
defencoding utf8
term screen-256color
truecolor on
defbce on
altscreen on
termcapinfo xterm* ti@:te@
vbell off
defscrollback 10000
defnonblock 5
bind ^k
bind ^\
bind \\ quit
bind K kill
bind } history
hardstatus off
termcapinfo xterm*|rxvt*|kterm*|Eterm* hs:ts=\E]0;:fs=\007:ds=\E]0;\007
hardstatus string "%h%? users: %u%?"
termcapinfo xterm*|linux*|rxvt*|Eterm* OP
